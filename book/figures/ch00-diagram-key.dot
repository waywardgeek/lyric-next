digraph Common {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.3, ranksep=0.45, splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=17, margin="0.12,0.08", color="#415466"];
edge [fontname="Helvetica", fontsize=13, arrowsize=1.05];
"Document" [label="Document", fillcolor="#edf4fb"];
"Cursor" [label="Cursor", fillcolor="#edf4fb"];
"Paragraph" [label="Paragraph", fillcolor="#edf4fb"];
"TextStyle" [label="TextStyle\n(value)", fillcolor="#edf4fb"];
"Layout" [label="Layout", fillcolor="#edf4fb"];
"Document" -> "Paragraph" [id="paragraphs", color="#164f86", penwidth=2, style=solid, arrowhead=normal, label="", tooltip="Document.paragraphs -> Paragraph"];
"Document" -> "Cursor" [id="cursor", color="#164f86", penwidth=2, style=solid, arrowhead=onormal, label="", tooltip="Document.cursor -> Cursor"];
"Cursor" -> "Paragraph" [id="selected", color="#a74b00", penwidth=1.2, style=dashed, arrowhead=onormal, label="selected", tooltip="Cursor.selected -> Paragraph"];
"Paragraph" -> "TextStyle" [id="style", color="#687682", penwidth=1.2, style=dotted, arrowhead=onormal, label="", tooltip="Paragraph.style -> TextStyle"];
"Paragraph" -> "Layout" [id="layout", color="#704090", penwidth=1.2, style=dashed, arrowhead=normal, label="", tooltip="Paragraph.layout -> Layout"];
}
