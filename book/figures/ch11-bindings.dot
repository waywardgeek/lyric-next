digraph Common {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.3, ranksep=0.45, splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=17, margin="0.12,0.08", color="#415466"];
edge [fontname="Helvetica", fontsize=13, arrowsize=1.05];
"GenericSpecialization" [label="GenericSpecialization", fillcolor="#edf4fb"];
"GenericBinding" [label="GenericBinding", fillcolor="#edf4fb"];
"SemanticType" [label="SemanticType\n(existing)", fillcolor="#ffffff"];
"GenericSpecialization" -> "GenericBinding" [id="generic-bindings", color="#164f86", penwidth=2, style=solid, arrowhead=normal, label="ordered\nbindings", tooltip="GenericSpecialization.Bindings -> GenericBinding; reverse GenericBinding.Specialization"];
"SemanticType" -> "GenericBinding" [id="generic-type-users", color="#704090", penwidth=1.2, style=dashed, arrowhead=normal, label="binding\ndependents", tooltip="SemanticType.GenericBindings -> GenericBinding; reverse GenericBinding.Type"];
}
