digraph Common {
graph [rankdir=TB, bgcolor="white", pad=0.15, nodesep=0.3, ranksep=0.45, splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=17, margin="0.12,0.08", color="#415466"];
edge [fontname="Helvetica", fontsize=13, arrowsize=1.05];
"SemanticAnalysis" [label="SemanticAnalysis\n(existing)", fillcolor="#ffffff"];
"MultiClassInstantiation" [label="MultiClassInstantiation", fillcolor="#edf4fb"];
"SemanticSymbol" [label="SemanticSymbol\n(existing)", fillcolor="#ffffff"];
"SemanticAnalysis" -> "MultiClassInstantiation" [id="analysis-multiclass", color="#164f86", penwidth=2, style=solid, arrowhead=normal, label="interface\napplications", tooltip="SemanticAnalysis.MultiClassInstantiations -> MultiClassInstantiation; reverse MultiClassInstantiation.Analysis"];
"SemanticSymbol" -> "MultiClassInstantiation" [id="template-multiclass", color="#164f86", penwidth=2, style=solid, arrowhead=normal, label="template\napplications", tooltip="SemanticSymbol.MultiClassInstantiations -> MultiClassInstantiation; reverse MultiClassInstantiation.Template"];
}
