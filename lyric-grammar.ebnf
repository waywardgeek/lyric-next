(* Lyric syntax grammar — review draft 1.
   Source: background/lyric-language-spec.md and the approved new specification.
   Status: proposed normative grammar, NOT an implemented or parser-tested grammar.
   Read grammar-review.md for lexical conventions, disambiguation rules,
   proposal IDs, semantic restrictions, source mapping, and deferred syntax.

   EBNF notation: = defines; ; ends a production; | is choice;
   [ ] is optional; { } is repetition; ( ) groups; quoted text is a terminal;
   ? ... ? denotes a precisely described external lexical character class/token.
   Whitespace between grammar symbols is metasyntactic, not source whitespace.
   No production named Expr encodes type checking or lifetime validity.
*)

(* 1. Lexical layer. Token classes and keyword policy: review L1–L5.
   Ident excludes hard keywords; contextual words remain identifiers except
   where the grammar recognizes their contextual role. D1 settles that policy.
*)
Ident = IdentifierSpelling ;
IdentifierSpelling = IdentifierStart, { IdentifierContinue } ;
IdentifierStart = AsciiLetter | "_" ;
IdentifierContinue = IdentifierStart | Digit ;
AsciiLetter = ? ASCII A–Z or a–z; proposed initial identifier alphabet D1 ? ;
Digit = ? ASCII 0–9 ? ;
HexDigit = Digit | ? ASCII A–F or a–f ? ;
Digits = Digit, { Digit | "_", Digit } ;
IntegerLiteral = Digits ;
FloatLiteral = Digits, ".", Digits ;
ByteLiteral = "'", ( ByteChar | Escape ), "'" ;
ByteChar = ? one unescaped source character encoding exactly one byte,
             excluding apostrophe, backslash, CR and LF ? ;
Escape = "\\", ( "n" | "r" | "t" | "\\" | "'" | '"' | "0"
                | "x", HexDigit, HexDigit ) ;
StringLiteral = '"', { StringChar | Escape }, '"' ;
StringChar = ? a source character except double quote, backslash, CR and LF ? ;
TripleStringLiteral = '"""', { TripleChar }, '"""' ;
TripleChar = ? next source character not starting the closing triple quote;
               delimiter/escape proposal D2 applies ? ;
SymbolLiteral = "`", { SymbolChar }, "`" ;
SymbolChar = ? a source character except backtick, CR and LF;
               no escape processing in this draft (D2) ? ;
FString = 'f"', { FStringText | Interpolation }, '"' ;
FStringText = FStringChar | Escape | "{{" | "}}" ;
FStringChar = ? a source character except double quote, backslash,
                opening/closing brace, CR and LF ? ;
Interpolation = "{", Expr, "}" ;
LineComment = "//", { CommentChar } ;
CommentChar = ? a source character other than CR or LF ? ;
HorizontalSpace = ? space or horizontal tab ? ;
NL = ? one logical newline token after delimiter-aware processing (L3) ? ;
EOF = ? end of source ? ;

(* At the syntax layer, ordinary horizontal space and comments are skipped.
   Literal contents are scanned in their own modes. NL is significant unless
   suppressed by the delimiter rules. Separators are not expressions.
*)
Sep = ( NL | ";" ), { NL | ";" } ;
SepOpt = { NL | ";" } ;
NLs = { NL } ;
MemberSep = Sep | ",", SepOpt ;

(* 2. Files and declarations.
   Same grammar for .ly and .lyric; declaration-only checking forbids executable
   bodies in .lyric, without forbidding declarations' constant/default values.
   Optional historic lyric wrappers are deferred, not accepted accidentally.
*)
File = SepOpt, [ TopItem, { Sep, TopItem }, [ Sep ] ], EOF ;
TopItem = ImportDecl | TypeAlias | StructDecl | ClassDecl | EnumDecl
        | InterfaceDecl | ImplDecl | RelationDecl | FunctionDecl | GlobalBinding ;
Visibility = [ "pub" ] ;
ImportDecl = "import", Ident, [ "from", StringLiteral ] ;
TypeAlias = Visibility, "type", Ident, "=", Type ;
GlobalBinding = Visibility, ( "let" | "var" ), Ident,
                [ ":", Type ], "=", Expr ;

StructDecl = Visibility, "struct", Ident, [ TypeParams ], StructBody ;
StructBody = "{", SepOpt,
             [ FieldDecl, { MemberSep, FieldDecl }, [ MemberSep ] ], "}" ;
ClassDecl = Visibility, [ "value" ], "class", Ident, [ TypeParams ], ClassBody ;
ClassBody = "{", SepOpt,
            [ ClassMember, { MemberSep, ClassMember }, [ MemberSep ] ], "}" ;
ClassMember = FieldDecl | FunctionDecl ;
FieldDecl = Visibility, Ident, ":", Type, [ "=", Expr ] ;

EnumDecl = Visibility, "enum", Ident, [ TypeParams ], EnumBody ;
EnumBody = "{", SepOpt, { EnumVariant, [ MemberSep ] }, "}" ;
EnumVariant = Ident, [ "(", [ VariantFields ], ")" ] ;
VariantFields = VariantField, { ",", VariantField }, [ "," ] ;
VariantField = Ident, ":", Type ;

InterfaceDecl = Visibility, "interface", Ident, [ TypeParams ],
                [ "extends", Capability ], InterfaceBody ;
InterfaceBody = "{", SepOpt,
                [ InterfaceMember, { Sep, InterfaceMember }, [ Sep ] ], "}" ;
InterfaceMember = FunctionDecl | InterfaceField | AbstractRelation
                | CleanupTemplate ;
InterfaceField = "field", Ident, ".", Ident, ":", Type ;
CleanupTemplate = "destructor", RelationKind, Ident, Block ;

FunctionDecl = Visibility, [ "final" ], "func", FunctionName,
               [ TypeParams ], Parameters, [ "->", Type ],
               [ WhereClause ], [ Block ] ;
FunctionName = QualifiedName ;
Parameters = "(", [ ParameterList ], ")" ;
ParameterList = Parameter, { ",", Parameter }, [ "," ] ;
Parameter = "self" | Ident, ":", Type ;
TypeParams = "<", TypeParam, { ",", TypeParam }, ">" ;
TypeParam = Ident, [ ":", QualifiedName ] ;
WhereClause = "where", Requirement, { ",", Requirement } ;
Requirement = Capability | Ident, ":", QualifiedName ;
Capability = QualifiedName, [ BindingArgs ] ;

(* 3. Relations and implementation bindings.
   Single uses an unbracketed child; many-child representations use brackets.
   The cardinality/type/role fit is checked semantically.
*)
RelationDecl = "relation", Hint, Endpoint, RelationKind, ChildEndpoint ;
AbstractRelation = "relation", Hint, Endpoint, [ RelationKind ], ChildEndpoint ;
Hint = QualifiedName ;
RelationKind = "owns" | "refs" ;
Endpoint = NamedType, [ ":", Ident ] ;
ChildEndpoint = Endpoint | "[", Endpoint, "]" ;
BindingArgs = "<", BindingArg, { ",", BindingArg }, ">" ;
BindingArg = Type, [ ":", Ident ] ;
ImplDecl = "impl", [ TypeParams ], QualifiedName, BindingArgs,
           [ RelationKind ], ImplBody ;
ImplBody = "{", SepOpt, [ ImplMember, { Sep, ImplMember }, [ Sep ] ], "}" ;
ImplMember = RelationBinding | FieldBinding | MethodBinding ;
RelationBinding = RelationRoles, "=", RelationRoles ;
RelationRoles = Endpoint, "/", Endpoint ;
FieldBinding = MemberPath, "<->", MemberPath ;
MethodBinding = MemberPath, "=", ( MemberPath | Adapter ) ;
MemberPath = Ident, ".", Ident, { ".", Ident } ;
Adapter = "(", [ AdapterParams ], ")", "->", Type, Block ;
AdapterParams = AdapterParam, { ",", AdapterParam }, [ "," ] ;
AdapterParam = "self" | Ident, [ ":", Type ] ;

(* 4. Types. Parenthesized type grouping is draft resolution D4.
   Generic closes are contextual '>' tokens, including halves of '>>' in
   type-argument context. Expression shifts retain the >> operator (L4).
*)
Type = UnionType ;
UnionType = PrefixType, { "|", PrefixType } ;
PrefixType = ( "ref" | "gen" ), PrefixType | OptionalType ;
OptionalType = TypePrimary, [ "?" ] ;
TypePrimary = NamedType | ArrayType | ParenthesizedType | FunctionType ;
NamedType = QualifiedName, [ TypeArgs ] ;
QualifiedName = Ident, { ".", Ident } ;
TypeArgs = "<", Type, { ",", Type }, ">" ;
ArrayType = "[", Type, "]" ;
ParenthesizedType = "(", Type, [ ",", Type, { ",", Type }, [ "," ] ], ")" ;
FunctionType = "fn", "(", [ TypeList ], ")", "->", Type ;
TypeList = Type, { ",", Type }, [ "," ] ;

(* 5. Statements and blocks. D5 defines block-tail values and separators;
   return/yield cannot consume an expression from the next logical line.
*)
Block = "{", SepOpt, [ Statement, { Sep, Statement }, [ Sep ] ], "}" ;
Statement = LocalBinding | ReturnStmt | YieldStmt | BreakStmt | ContinueStmt
          | WhileStmt | ForStmt | Block | ExpressionStmt ;
LocalBinding = ( "let" | "var" ), Pattern, BindingTail ;
BindingTail = ":", Type, [ "=", Expr ], [ LetElse ]
            | "=", Expr, [ LetElse ] ;
LetElse = "else", Block ;
ReturnStmt = "return", [ Expr ] ;
YieldStmt = "yield", Expr ;
BreakStmt = "break" ;
ContinueStmt = "continue" ;
WhileStmt = "while", HeaderExpr, Block ;
ForStmt = "for", Pattern, [ ",", Ident ], "in", HeaderExpr, Block ;
ExpressionStmt = Expr, [ AssignmentOp, Expr ] ;
AssignmentOp = "=" | "+=" | "-=" | "*=" | "/=" | "!+=" | "!-=" | "!*=" ;

(* 6. Expression precedence: lowest to highest.
   Repetition at a binary level folds left. Prefix operators nest right.
   'ref' has prefix precedence in this draft (D6); it does not copy storage.
*)
Expr = LogicalOr ;
LogicalOr = LogicalAnd, { "||", LogicalAnd } ;
LogicalAnd = Equality, { "&&", Equality } ;
Equality = Comparison, { ( "==" | "!=" ), Comparison } ;
Comparison = BitOr, { ( "<" | "<=" | ">" | ">=" ), BitOr } ;
BitOr = BitXor, { "|", BitXor } ;
BitXor = BitAnd, { "^", BitAnd } ;
BitAnd = Shift, { "&", Shift } ;
Shift = Additive, { ( "<<" | ">>" ), Additive } ;
Additive = Multiplicative, { ( "+" | "-" | "!+" | "!-" ), Multiplicative } ;
Multiplicative = PrefixExpr, { ( "*" | "/" | "%" | "!*" ), PrefixExpr } ;
PrefixExpr = ( "-" | "!-" | "!" | "ref" ), PrefixExpr | PostfixExpr ;
PostfixExpr = Primary, { PostfixPart } ;
PostfixPart = CallSuffix | MemberSuffix | GenericSuffix | IndexSuffix
            | "!" | "?" | CastSuffix | VariantTest ;
CallSuffix = "(", [ ArgumentList ], ")" ;
ArgumentList = Expr, { ",", Expr }, [ "," ] ;
MemberSuffix = ".", Ident ;
GenericSuffix = BindingArgs ;
IndexSuffix = "[", ( Expr, [ ":", [ Expr ] ] | ":", [ Expr ] ), "]" ;
CastSuffix = ( "as" | "!as" ), CastType ;
CastType = PrefixType ;
VariantTest = "is", QualifiedName ;
Primary = Literal | Ident | "self" | UnitExpr | ParenthesizedExpr
        | TupleExpr | ArrayExpr | RecordExpr | ClosureExpr | IfExpr | MatchExpr ;
Literal = IntegerLiteral | FloatLiteral | ByteLiteral | StringLiteral
        | TripleStringLiteral | SymbolLiteral | FString | "true" | "false" | "null" ;
UnitExpr = "(", ")" ;
ParenthesizedExpr = "(", Expr, ")" ;
TupleExpr = "(", Expr, ",", Expr, { ",", Expr }, [ "," ], ")" ;
ArrayExpr = "[", [ ArgumentList ], "]" ;
RecordExpr = NamedType, "{", SepOpt, [ FieldValues ], "}" ;
FieldValues = FieldValue, { MemberSep, FieldValue }, [ MemberSep ] ;
FieldValue = Ident, ":", Expr ;
ClosureExpr = "(", [ ClosureParams ], ")", "->", Type, Block ;
ClosureParams = ClosureParam, { ",", ClosureParam }, [ "," ] ;
ClosureParam = Ident, ":", Type ;
IfExpr = "if", Condition, Block, [ NLs, "else", ( IfExpr | Block ) ] ;
Condition = HeaderExpr | "let", Pattern, "=", HeaderExpr ;
MatchExpr = "match", HeaderExpr, "{", SepOpt,
            [ MatchArm, { Sep, MatchArm }, [ Sep ] ], "}" ;
MatchArm = MatchPatterns, [ "if", HeaderExpr ], "=>", Block ;
MatchPatterns = Pattern, { "|", Pattern } ;

(* D3: Header expressions exclude a direct record literal. Nested parentheses,
   array elements, and call arguments use ordinary Expr and permit records.
   The duplicated precedence ladder is intentional: it makes this restriction
   grammar-visible rather than a hidden no_struct_lit parser flag.
*)
HeaderExpr = HeaderLogicalOr ;
HeaderLogicalOr = HeaderLogicalAnd, { "||", HeaderLogicalAnd } ;
HeaderLogicalAnd = HeaderEquality, { "&&", HeaderEquality } ;
HeaderEquality = HeaderComparison, { ( "==" | "!=" ), HeaderComparison } ;
HeaderComparison = HeaderBitOr, { ( "<" | "<=" | ">" | ">=" ), HeaderBitOr } ;
HeaderBitOr = HeaderBitXor, { "|", HeaderBitXor } ;
HeaderBitXor = HeaderBitAnd, { "^", HeaderBitAnd } ;
HeaderBitAnd = HeaderShift, { "&", HeaderShift } ;
HeaderShift = HeaderAdditive, { ( "<<" | ">>" ), HeaderAdditive } ;
HeaderAdditive = HeaderMultiplicative,
                 { ( "+" | "-" | "!+" | "!-" ), HeaderMultiplicative } ;
HeaderMultiplicative = HeaderPrefixExpr,
                       { ( "*" | "/" | "%" | "!*" ), HeaderPrefixExpr } ;
HeaderPrefixExpr = ( "-" | "!-" | "!" | "ref" ), HeaderPrefixExpr
                 | HeaderPostfixExpr ;
HeaderPostfixExpr = HeaderPrimary, { PostfixPart } ;
HeaderPrimary = Literal | Ident | "self" | UnitExpr | ParenthesizedExpr
              | TupleExpr | ArrayExpr | ClosureExpr | IfExpr | MatchExpr ;

(* D3: GenericSuffix is admitted in expression context only under the stated
   syntactic lookahead rule: a complete BindingArgs followed by '(' or '.'.
   Example f<T>(x) or Collection<N:out,E:source>.count(node).
   CastType stops a bare type before expression '|'; write a grouped union
   type as x as (A | B). D4 explains nullable '?' versus result propagation.
*)

(* 7. Patterns. Name resolution, not capitalization, distinguishes a binding,
   nullary variant, or union alternative type. Pattern alternatives occur at
   match-arm level. Explicit borrowed-payload pattern syntax is still deferred.
*)
Pattern = "_" | PatternLiteral | NamePattern | TuplePattern ;
PatternLiteral = IntegerLiteral | "-", IntegerLiteral | ByteLiteral
               | StringLiteral | "true" | "false" | "null" ;
NamePattern = QualifiedName, [ "(", [ PatternList ], ")" ] ;
PatternList = Pattern, { ",", Pattern }, [ "," ] ;
TuplePattern = "(", Pattern, ",", Pattern, { ",", Pattern }, [ "," ], ")" ;

(* 8. Not in the accepted syntax of this draft:
   unresolved lock/spawn/channel/FFI/guard syntax; expression-derived casts;
   mut parameters/bindings; root classes; attach clauses; pipe closures;
   positional record literals; one-element tuples; implicit scope projection;
   legacy map syntax; permanent/trusted/unref surface privileges; bare import
   paths; implements and lyric wrappers; bare destructor shorthand; constraint
   aliases. Some are deferred choices, not permanently rejected features.
   Dictionary literals are explicitly deferred coverage work, not silently
   reinterpreted as blocks. See the review's inventory and decision priorities.
*)
