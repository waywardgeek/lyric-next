  "type_policy": "canonical",
  "historical_commit": "6073e136c772019dc8dbe4ca11211340904cbf9e",
  "changes": {
    "canonical-types": {
      "previous": [],
      "reason": "Canonical identities are now strongly owned by analysis buckets."
    },
    "array-types": {
      "previous": [],
      "reason": "An array key depends on its canonical element; element retirement retires dependent arrays."
    },
    "tuple-positions": {
      "previous": [],
      "reason": "The tuple owns one occurrence per position."
    },
    "component-users": {
      "previous": [],
      "reason": "Shared component retirement invalidates dependent tuple keys, not vice versa."
    },
    "canonical-symbols": {
      "previous": [
        "symbol-type",
        "typed-symbols"
      ],
      "reason": "Canonical types replace flat values and class-only reverse symbol lists."
    },
    "canonical-facts": {
      "previous": [
        "fact-type",
        "typed-facts"
      ],
      "reason": "TypeLink replaces the stored flat fact type and class-only reverse facts."
    },
    "canonical-ir": {
      "previous": [
        "ir-type",
        "typed-ir"
      ],
      "reason": "Every IR type now registers on its canonical identity; graph teardown precedes semantic retirement."
    },
    "member-scope": {
      "previous": [
        "member-scope"
      ],
      "reason": "MemberOwner generalizes the former class-only owner to classes and structs."
    },
    "nominal": {
      "previous": [
        "nominal"
      ],
      "reason": "The canonical nominal type now has a reciprocal declaration dependency for classes and structs."
    },
    "initializer-scope": {
      "previous": [],
      "reason": "A defaulted struct field co-owns its execution scope with the analysis."
    },
    "implementation": {
      "previous": [],
      "reason": "Separate implementation syntax links to the original callable identity, not a duplicate symbol."
    },
    "ir-declaration": {
      "previous": [
        "ir-declaration"
      ],
      "reason": "The existing weak Declaration/IrBody link now also identifies a generated field-initializer body; IrProgram still owns it."
    }
  }
}
