  "changes": {
    "analysis-multiclass": {
      "previous": [],
      "reason": "Analysis and template co-own each application; retirement removes both memberships."
    },
    "template-multiclass": {
      "previous": [],
      "reason": "The interface declaration owns applications of its body; retiring it retires them."
    },
    "multiclass-participants": {
      "previous": [],
      "reason": "Each endpoint occurrence has its own identity even when concrete classes repeat."
    },
    "multiclass-syntax": {
