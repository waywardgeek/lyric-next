{
  "schema": 1,
  "types": {
    "Compilation": {
      "introduced": 1,
      "description": "Owns the loaded source files and, from Chapter 4 onward, their shared semantic analysis.",
      "value": false
    },
    "SourceFile": {
      "introduced": 1,
      "description": "Owns the original immutable UTF-8 bytes and their path. Later chapters attach tokens and syntax nodes to this same source.",
      "value": false
    },
    "Diagnostic": {
      "introduced": 1,
      "description": "A value-like error code, message, byte offset, line and column. It stores a location, not a source-object relationship.",
      "value": true
    },
    "Token": {
      "introduced": 2,
      "description": "One lexical decision anchored in the original source bytes. Its source owns it; decoded literal bytes are immutable value data.",
      "value": false
    },
    "SyntaxNode": {
      "introduced": 3,
      "description": "Source-owned syntax with original byte offsets. A generic specialization or multi-class instantiation co-owns its copied nodes, never both; copied nodes are not parsed roots.",
      "value": false
    },
    "SyntaxFailure": {
      "introduced": 3,
      "description": "A value-like exception carrying a Diagnostic to unwind a failed parse. Partially built nodes remain owned by the source.",
      "value": true
    },
    "SemanticAnalysis": {
      "introduced": 4,
      "description": "Owns canonical types, scopes, facts, generic specializations and multi-class instantiations. Retires derived IR before semantic teardown.",
      "value": false
    },
    "SemanticScope": {
      "introduced": 4,
      "description": "An analysis-owned environment. An instantiation additionally owns its private annotation and method scopes; lexical ancestry remains non-owning.",
      "value": false
    },
    "SemanticSymbol": {
      "introduced": 4,
      "description": "A declaration identity: interface template, concrete class, contributed member, or lookup-only member namespace. Scope owns each symbol; an instantiation also owns its contributions. A namespace adds no runtime object.",
      "value": false
    },
    "SemanticFact": {
      "introduced": 4,
      "description": "An analysis-owned checked expression. Its canonical type and optional participant view describe runtime representation and compile-time lookup separately.",
      "value": false
    },
    "SemanticFailure": {
      "introduced": 4,
      "description": "A value-like exception carrying a Diagnostic to unwind semantic checking. It does not own semantic model objects.",
      "value": true
    },
    "SemanticType": {
      "introduced": 7,
      "description": "One analysis-owned canonical identity. Immutable keys depend on element, nominal declaration, or ordered tuple components; retirement invalidates users, never shared ingredients.",
      "value": false
    },
    "IrProgram": {
      "introduced": 9,
      "description": "The execution representation owned by one semantic analysis. Owns all source-function, field-initializer, and generated-destruction bodies.",
      "value": false
    },
    "IrFunction": {
      "introduced": 9,
      "description": "A program-owned executable IR body. Source callables and field initializers use Declaration/IrBody; class destruction uses its separate role link. These weak identities do not own the body.",
      "value": false
    },
    "IrNode": {
      "introduced": 9,
      "description": "One typed operation or structured region. The function owns it; ordered child links describe execution, operands provide inputs, and semantic/source links preserve checked meaning.",
      "value": false
    },
    "IrOperand": {
      "introduced": 9,
      "description": "One ordered input use, owned by the consuming node. It points non-owningly to its defining node, which keeps a reverse list of uses.",
      "value": false
    },
    "IrLiteral": {
      "introduced": 9,
      "description": "An immutable value-like integer, boolean or byte payload. Byte data is copied at construction; a literal is not a runtime array owner.",
      "value": true
    },
    "SemanticTypeComponent": {
      "introduced": 10,
      "value": false,
      "description": "One tuple-owned position, with a non-owning dependency on its shared component type. Repeated component identities still have distinct positions."
    },
    "GenericSpecialization": {
      "introduced": 11,
      "value": false,
      "description": "A concrete callable keyed by its template and ordered canonical bindings. Analysis and template co-own it; it owns its callable, binding occurrences, copied syntax, and concrete-body scopes."
    },
    "GenericBinding": {
      "introduced": 11,
      "value": false,
      "description": "One ordered type-argument occurrence, owned by its specialization. Its canonical type retains the reverse dependency; retiring that type retires the specialization without retiring other argument types."
    },
    "MultiClassInstantiation": {
      "introduced": 12,
      "value": false,
      "description": "One compile-time interface application, keyed by its template and ordered class/label occurrences. Analysis and template co-own it; it owns contributions, private scopes, copied syntax and participant occurrences."
    },
    "ParticipantBinding": {
      "introduced": 12,
      "value": false,
      "description": "One ordered participant occurrence, owned by its instantiation and dependent on a concrete class. It keeps contributor and lookup-view relationships separate; position and label are value data."
    }
  },
