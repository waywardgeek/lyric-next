{
  "schema": 1,
  "types": {
    "Compilation": {
      "introduced": 1,
      "description": "Owns the loaded source files and, from Chapter 4 onward, their shared semantic analysis.",
      "value": false
    },
    "SourceFile": {
      "introduced": 1,
      "description": "Owns the original immutable UTF-8 bytes and their path. Later chapters attach tokens and syntax nodes to this same source.",
      "value": false
    },
    "Diagnostic": {
      "introduced": 1,
      "description": "A value-like error code, message, byte offset, line and column. It stores a location, not a source-object relationship.",
      "value": true
    },
    "Token": {
      "introduced": 2,
      "description": "One lexical decision anchored in the original source bytes. Its source owns it; decoded literal bytes are immutable value data.",
      "value": false
    },
    "SyntaxNode": {
      "introduced": 3,
      "description": "One parsed construct. Its source owns its lifetime; ordered parent/child links describe syntax without owning neighboring nodes.",
      "value": false
    },
    "SyntaxFailure": {
      "introduced": 3,
      "description": "A value-like exception carrying a Diagnostic to unwind a failed parse. Partially built nodes remain owned by the source.",
      "value": true
    },
    "SemanticAnalysis": {
      "introduced": 4,
      "description": "The compilation-owned analysis of all source trees. Owns every scope and checked fact, including incomplete construction.",
      "value": false
    },
    "SemanticScope": {
      "introduced": 4,
      "description": "A lexical namespace that owns declaration symbols. Analysis owns every scope; a function also owns its function scope. Lexical parent/child links are non-owning.",
      "value": false
    },
    "SemanticSymbol": {
      "introduced": 4,
      "description": "The identity of a declaration, owned by its scope. User declarations link to syntax; builtins need no invented syntax node. Function symbols also own their function scope.",
      "value": false
    },
    "SemanticFact": {
      "introduced": 4,
      "description": "A checked expression: its type, optional constant and resolved declaration. Analysis owns it; syntax and declaration links let checking and emission share the same result.",
      "value": false
    },
    "SemanticFailure": {
      "introduced": 4,
      "description": "A value-like exception carrying a Diagnostic to unwind semantic checking. It does not own semantic model objects.",
      "value": true
    },
    "SemanticType": {
      "introduced": 7,
      "description": "An immutable value describing a scalar kind and array nesting depth. It replaces the earlier scalar-only enum; Chapter 8 adds an optional nominal class identity.",
      "value": true
    },
    "IrProgram": {
      "introduced": 9,
      "description": "The execution representation owned by one semantic analysis. Owns all source-function and generated-destruction bodies.",
      "value": false
    },
    "IrFunction": {
      "introduced": 9,
      "description": "Owns every node in one function arena, even detached drafts. Its body link selects the root region; its source declaration or destruction-class link identifies what it implements.",
      "value": false
    },
    "IrNode": {
      "introduced": 9,
      "description": "One typed operation or structured region. The function owns it; ordered child links describe execution, operands provide inputs, and semantic/source links preserve checked meaning.",
      "value": false
    },
    "IrOperand": {
      "introduced": 9,
      "description": "One ordered input use, owned by the consuming node. It points non-owningly to its defining node, which keeps a reverse list of uses.",
      "value": false
    },
    "IrLiteral": {
      "introduced": 9,
      "description": "An immutable value-like integer, boolean or byte payload. Byte data is copied at construction; a literal is not a runtime array owner.",
      "value": true
    }
  },
